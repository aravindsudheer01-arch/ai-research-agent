# Default: Groq free-tier account. Keep billing disabled for a free-only demo.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# To switch to OpenAI: set LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Other OpenAI-compatible chat APIs must support tool calling:
# LLM_PROVIDER=compatible
# LLM_MODEL=your-model-id
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
